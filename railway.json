{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm --prefix AI-Portfolio install && npm --prefix AI-Portfolio run build"
  },
  "deploy": {
    "startCommand": "npm --prefix AI-Portfolio start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
